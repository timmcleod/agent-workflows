{
    "name": "timmcleod/agent-workflows",
    "description": "Durable, resumable, human-interruptible agent workflows for the Laravel AI SDK — crash-safe orchestration on Laravel queues.",
    "keywords": ["laravel", "ai", "agents", "workflows", "durable", "queues", "orchestration"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tim McLeod",
            "email": "tim@timmcleod.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/concurrency": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "laravel/ai": "^0.10.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "TimMcLeod\\AgentWorkflows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimMcLeod\\AgentWorkflows\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.15.x-dev"
        },
        "laravel": {
            "providers": [
                "TimMcLeod\\AgentWorkflows\\AgentWorkflowsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "stable"
}
